# Postgres. Neon and Supabase both work. Vercel Postgres works too.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs session cookies and magic links. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The public origin, used in emails and in the calendar feed URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email. Set EITHER the Gmail pair OR the Resend key. Gmail is checked first.
#
# Gmail needs two factor authentication switched on, then an app password from
# myaccount.google.com/apppasswords. It delivers to anyone, no domain required.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Resend only delivers to your own address until you verify a sending domain.
RESEND_API_KEY=""

# Optional. Defaults to the Gmail address when Gmail is in use.
EMAIL_FROM="Somewhere <you@gmail.com>"

# Guards the daily reminder job. Generate with: openssl rand -base64 32
CRON_SECRET=""

# Photo storage. Any S3 compatible bucket: AWS, Cloudflare R2, Backblaze.
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""
